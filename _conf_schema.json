{
    "enabled": {
        "description": "启用插件",
        "type": "bool",
        "hint": "是否启用 Forest 房间密钥提取功能",
        "default": true
    },
    "reply_format": {
        "description": "回复格式",
        "type": "string",
        "hint": "检测到房间密钥后的回复格式，使用 {key} 作为密钥占位符",
        "default": "{key}"
    },
    "whitelist": {
        "description": "白名单群号",
        "type": "list",
        "hint": "只在这些群聊启用功能，为空则全部群生效",
        "default": [],
        "items": {
            "type": "string"
        }
    },
    "blacklist": {
        "description": "黑名单群号",
        "type": "list",
        "hint": "在这些群聊禁用功能",
        "default": [],
        "items": {
            "type": "string"
        }
    },
    "rate_limit_enabled": {
        "description": "启用限流",
        "type": "bool",
        "hint": "是否启用响应频率限制",
        "default": true
    },
    "rate_limit_window": {
        "description": "限流时间窗口（秒）",
        "type": "int",
        "hint": "限流的时间窗口，默认60秒",
        "default": 60
    },
    "rate_limit_count": {
        "description": "时间窗口内最大响应次数",
        "type": "int",
        "hint": "在时间窗口内每个群最多响应的次数，默认10次",
        "default": 10
    }
}
